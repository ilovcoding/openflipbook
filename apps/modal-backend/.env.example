# Endless Canvas — Modal backend (also used by local_server.py)
FAL_KEY=

# Pick one LLM provider:
#   openrouter (default, uses OPENROUTER_API_KEY)
#   dashscope  (Alibaba Cloud Model Studio / Bailian, uses DASHSCOPE_API_KEY)
LLM_PROVIDER=openrouter

OPENROUTER_API_KEY=
DASHSCOPE_API_KEY=
DASHSCOPE_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1

# Optional overrides (defaults in providers/llm.py + providers/image.py)
OPENROUTER_VLM_MODEL=google/gemini-3-flash-preview
OPENROUTER_TEXT_MODEL=google/gemini-3-flash-preview
OPENROUTER_ENABLE_WEB_SEARCH=true
DASHSCOPE_VLM_MODEL=qwen-vl-plus
DASHSCOPE_TEXT_MODEL=qwen-plus
DASHSCOPE_ENABLE_WEB_SEARCH=true
# For qwen3/qwen3.6 family models, keep thinking off for JSON-heavy prompts.
DASHSCOPE_ENABLE_THINKING=false
IMAGE_PROVIDER=dashscope
DASHSCOPE_IMAGE_MODEL=qwen-image-plus
DASHSCOPE_IMAGE_MODEL_FAST=qwen-image-plus
DASHSCOPE_IMAGE_MODEL_BALANCED=qwen-image-plus
DASHSCOPE_IMAGE_MODEL_PRO=qwen-image-2.0-pro
FAL_IMAGE_MODEL=fal-ai/nano-banana
FAL_ANIMATE_MODEL=fal-ai/ltx-video/image-to-video

# Per-tier video model overrides (defaults in providers/video.py).
# fast → LTX-Video (cheap), balanced → Wan 2.2 i2v, pro → LTX-2.
FAL_VIDEO_TIER_FAST=fal-ai/ltx-video/image-to-video
FAL_VIDEO_TIER_BALANCED=fal-ai/wan-i2v
FAL_VIDEO_TIER_PRO=fal-ai/ltx-2/image-to-video

# Disable the OpenRouter motion-prompt rewrite before /animate (default on).
# Set to "false" if you want the raw page title sent to fal.
ANIMATE_PROMPT_REWRITE=true
